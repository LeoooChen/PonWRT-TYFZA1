#!/usr/bin/env ucode
// SPDX-License-Identifier: GPL-2.0-or-later
'use strict';
import { readfile } from 'fs';

function fields(text) {
	if (text == null)
		return null;
	let result = {};
	for (let token in split(trim(text), /\s+/)) {
		let position = index(token, '=');
		if (position > 0)
			result[substr(token, 0, position)] = substr(token, position + 1);
	}
	return result;
}

function oam_ports() {
	let ports = [];
	const uptime = split(trim(readfile('/proc/uptime')), ' ');
	const now_ms = +uptime[0] * 1000;
	for (let llid = 0; llid < 32; llid++) {
		let text = readfile('/var/run/pon-oam/llid-' + llid + '.json');
		if (text == null)
			continue;
		let status = json(text);
		let process = readfile('/proc/' + status.pid + '/stat');
		let end = process != null ? index(process, ') ') : -1;
		let state = end >= 0 ? split(substr(process, end + 2), ' ') : [];
		status.live = length(state) > 19 && state[0] != 'Z' && state[0] != 'X' &&
			state[19] == status.process_start && now_ms >= status.updated_ms && now_ms - status.updated_ms < 5000;
		if (!status.live) {
			status.registered = false;
			status.auth_state = null;
			status.discovery_stable = false;
		}
		push(ports, status);
	}
	return ports;
}

const methods = {
	status: {
		call: function() {
			const device = '/sys/bus/platform/devices/4f5500000.pon/';
			return {
				state: fields(readfile(device + 'state')),
				serdes: fields(readfile(device + 'serdes')),
				bosa: fields(readfile(device + 'bosa')),
				mac: fields(readfile(device + 'mac')),
				mpcp: fields(readfile(device + 'mpcp')),
				traffic: fields(readfile(device + 'traffic')),
				optical: fields(readfile(device + 'optical')),
				puc: readfile(device + 'puc'),
				pdc: readfile(device + 'pdc'),
				llids: readfile(device + 'llid_table'),
				lan_rx_errors: trim(readfile('/sys/class/net/eth0/statistics/rx_errors')),
				lan_rx_dropped: trim(readfile('/sys/class/net/eth0/statistics/rx_dropped')),
				oam_ports: oam_ports(),
				queried_at: time()
			};
		}
	}
};

return { 'luci.tyfza1-pon': methods };
