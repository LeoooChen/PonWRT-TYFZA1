tyfza1_expand_storage() {
	[ "${INITRAMFS:-}" = 1 ] && return
	. /lib/upgrade/tyfza1-storage.sh
	tyfza1_boot_storage_plan || return 0
	echo "TYFZA1: expanding writable storage; the device will reboot once"
	. /lib/upgrade/common.sh
	install_bin /sbin/upgraded
	[ -x "$RAM_ROOT/sbin/upgraded" ] || return 1
	# procd's preinit handoff enters the same ramfs used by normal sysupgrade.
	printf '%s\000%s\000%s' "$RAM_ROOT" tyfza1-storage \
		'. /lib/functions.sh; include /lib/upgrade; tyfza1_migrate_storage && sync && reboot -f' \
		> /tmp/sysupgrade
	exit 0
}

boot_hook_add preinit_main tyfza1_expand_storage
