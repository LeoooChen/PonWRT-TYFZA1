#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name)" in
	tianyi,tyfza1-2p5g)
		lan_devs="lan4 lan3 lan2 lan1"
		usb_led=LED_USB1
		;;
	*)
		lan_devs="lan1 lan2 lan3 lan4"
		usb_led=LED_USB0
		;;
esac

migrate_usb_led() {
	local sysfs
	config_get sysfs "$1" sysfs
	case "$usb_led:$sysfs" in
		LED_USB1:LED_USB0) uci set "system.$1.sysfs=LED_USB1" ;;
	esac
}

match_led() {
	local sysfs
	config_get sysfs "$1" sysfs
	[ "$sysfs" != "$2" ] || found=1
}

has_led() {
	found=0
	config_foreach match_led led "$1"
	[ "$found" = 1 ]
}

config_load system
config_foreach migrate_usb_led led
config_load system
# config_generate skips LED defaults when sysupgrade preserves system config.
port=0
for lan in $lan_devs; do
	led="LED_EPHY$port"
	section="led_lan$port"
	port=$((port + 1))
	config_get sysfs "$section" sysfs
	config_get trigger "$section" trigger
	config_get dev "$section" dev
	# Retarget the old generated binding, not a custom netdev or trigger.
	if [ "$sysfs:$trigger:$dev" = "$led:netdev:lan$port" ] && [ "$dev" != "$lan" ]; then
		uci set "system.$section.dev=$lan"
	fi
	has_led "$led" && continue
	uci -q get "system.$section" >/dev/null && continue
	uci set "system.$section=led"
	uci set "system.$section.name=LAN${lan#lan}"
	uci set "system.$section.sysfs=$led"
	uci set "system.$section.trigger=netdev"
	uci set "system.$section.dev=$lan"
	uci set "system.$section.mode=link tx rx"
done
config_get sysfs led_usb sysfs
config_get trigger led_usb trigger
config_get ports led_usb port
if [ "$sysfs:$trigger:$ports" = "$usb_led:usbport:usb1-port1 usb2-port1" ]; then
	uci set system.led_usb.trigger=tyfza1-usb
	uci delete system.led_usb.port
fi
if ! has_led "$usb_led" && ! uci -q get system.led_usb >/dev/null; then
	uci set system.led_usb=led
	uci set system.led_usb.name=USB
	uci set "system.led_usb.sysfs=$usb_led"
	uci set system.led_usb.trigger=tyfza1-usb
fi
if ! uci -q get system.led_control >/dev/null; then
	uci set system.led_control=led_control
	uci set system.led_control.mode=2
fi
uci commit system
exit 0
