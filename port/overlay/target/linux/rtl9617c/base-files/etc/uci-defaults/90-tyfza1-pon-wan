#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
[ -e /sys/class/net/pon-data0/llid_index ] || exit 0
# All four copper interfaces are LAN. config_generate's generic eth1 WAN
# choice must be replaced by the native PON business interface.
case "$(uci -q get network.wan.device)" in
	''|eth1)
		uci set network.wan='interface'
		uci set network.wan.device='pon-data0'
		[ -n "$(uci -q get network.wan.proto)" ] || uci set network.wan.proto='dhcp'
		;;
esac
case "$(uci -q get network.wan6.device)" in
	''|pon-data0)
		uci set network.wan6='interface'
		uci set network.wan6.device='@wan'
		uci set network.wan6.proto='dhcpv6'
		;;
esac
# WAN6 follows the native PPP device; do not also create ppp.sh's auto WAN_6.
if [ "$(uci -q get network.wan6.device)" = @wan ] &&
   [ -z "$(uci -q get network.wan.ipv6)" ]; then
	uci set network.wan.ipv6='1'
fi
uci commit network
exit 0
