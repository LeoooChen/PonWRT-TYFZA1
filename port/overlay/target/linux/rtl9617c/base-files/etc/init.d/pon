#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=25
USE_PROCD=1
EXTRA_COMMANDS="offload"
EXTRA_HELP="        offload          Apply the firewall hardware offload setting"

offload() {
	local device=/sys/bus/platform/devices/4f5500000.pon
	local enabled=0

	[ -w "$device/fe" ] || return 0
	if [ "$(uci -q get 'firewall.@defaults[0].flow_offloading')" = 1 ] &&
	   [ "$(uci -q get 'firewall.@defaults[0].flow_offloading_hw')" = 1 ]; then
		enabled=1
	fi
	printf '%s\n' "$enabled" > "$device/fe"
}

start_service() {
	configure_link
	local result=$?
	printf 'error=%s\n' "$result" >> /var/run/pon-service
	return "$result"
}

configure_link() {
	local enabled mode onu_mac llids i
	local device=/sys/bus/platform/devices/4f5500000.pon

	# CPU/XRAM diagnostic DTBs omit the PON device.
	[ -w "$device/serdes" ] || return 0
	config_load pon
	config_get_bool enabled pon enabled 1
	printf 'enabled=%s error=0\n' "$enabled" > /var/run/pon-service
	[ "$enabled" = 1 ] || return 0
	config_get mode pon mode epon-d10g
	printf '1\n' > "$device/bosa" || return $?
	printf '%s\n' "$mode" > "$device/serdes" || return $?
	config_get onu_mac pon onu_mac
	[ -n "$onu_mac" ] || onu_mac=$(uci -q -c /var/run/tyfza1-factory get pon_factory.pon.onu_mac)
	printf '%s\n' "$onu_mac" > "$device/onu_mac" || return $?
	if [ "$mode" = gpon ] || [ "$mode" = xgpon ] || [ "$mode" = xgspon ]; then
		if [ "$mode" = gpon ]; then
			/usr/sbin/pon-identity "$device/gpon_identity" || return $?
		else
			/usr/sbin/pon-identity "$device/xgpon_identity" || return $?
		fi
		printf '1\n' > "$device/mac" || return $?
		printf '1\n' > "$device/puc" || return $?
		printf '1\n' > "$device/pdc" || return $?
		ip link set pon-omci up || return $?
		ip link set pon-data0 up || return $?
		printf '1\n' > "$device/activation" || return $?
		procd_open_instance omci
		procd_set_param command /usr/sbin/pon-omcid
		procd_set_param respawn 3600 5 3
		procd_set_param file /etc/config/pon
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		offload
		return $?
	fi
	config_get llids pon llid_count 1
	printf '%s\n' "$llids" > "$device/llid_count" || return $?
	printf '1\n' > "$device/mac" || return $?
	printf '1\n' > "$device/puc" || return $?
	printf '1\n' > "$device/pdc" || return $?
	i=0
	while [ "$i" -lt "$llids" ]; do
		printf '1\n' > "/proc/sys/net/ipv6/conf/pon-oam$i/disable_ipv6"
		ip link set "pon-oam$i" up || return $?
		ip link set "pon-data$i" up || return $?
		i=$((i + 1))
	done
	printf '1\n' > "$device/traffic" || return $?
	printf '1\n' > "$device/mpcp" || return $?
	i=0
	while [ "$i" -lt "$llids" ]; do
		procd_open_instance "oam-$i"
		procd_set_param command /usr/sbin/pon-oamd --interface "pon-oam$i" --llid-index "$i"
		procd_set_param respawn 3600 5 3
		procd_set_param file /etc/config/pon
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
		i=$((i + 1))
	done
	offload
}

stop_service() {
	local device=/sys/bus/platform/devices/4f5500000.pon
	local interface
	if [ -w "$device/activation" ]; then
		printf '0\n' > "$device/activation"
		ip link set pon-omci down
	fi
	if [ -w "$device/traffic" ]; then
		printf '0\n' > "$device/traffic"
		for interface in /sys/class/net/pon-oam*; do
			[ -d "$interface" ] && ip link set "${interface##*/}" down
		done
		for interface in /sys/class/net/pon-data*; do
			[ -d "$interface" ] && ip link set "${interface##*/}" down
		done
	fi
	[ -w "$device/mpcp" ] && printf '0\n' > "$device/mpcp"
	printf 'enabled=0 error=0\n' > /var/run/pon-service
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_open_trigger
	procd_add_reload_trigger pon
	procd_add_config_trigger "config.change" "firewall" /etc/init.d/pon offload
	procd_close_trigger
}
