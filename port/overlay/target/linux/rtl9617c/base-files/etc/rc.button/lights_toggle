#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
[ "$ACTION" = released ] || exit 0
mode=$(cat /sys/devices/platform/leds/mode) || exit $?
if [ "$mode" = 0 ]; then mode=2; else mode=0; fi
printf '%s\n' "$mode" > /sys/devices/platform/leds/mode || exit $?
uci set system.led_control=led_control
uci set system.led_control.mode="$mode"
uci commit system
