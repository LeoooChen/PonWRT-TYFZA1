--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -1,4 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
+config RTL9617C_FTTR
+	tristate "TYFZA1 native FTTR MiniOLT control"
+	depends on OF && ARCH_RTL9617C && MDIO_RTL9617C && I2C
+	select REGMAP
+	select FW_LOADER
+	help
+	  Native MDIO register transport for the TYFZA1 downstream MiniOLT.
+
 config RTL9617C_BOSA
 	tristate "RTL9617C optical front-end calibration"
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -1,3 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_RTL9617C_FTTR) += rtl9617c-fttr.o
+obj-$(CONFIG_RTL9617C_FTTR) += rtl9617c-fttr-bosa.o
 obj-$(CONFIG_RTL9617C_BOSA) += rtl9617c-bosa.o
 obj-$(CONFIG_RTL9617C_PON) += rtl9617c-pon-core.o
