diff --git a/arch/arm64/Kconfig.platforms b/arch/arm64/Kconfig.platforms
index 1317379..224c2b0 100644
--- a/arch/arm64/Kconfig.platforms
+++ b/arch/arm64/Kconfig.platforms
@@ -1,4 +1,10 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config ARCH_RTL9617C
+	bool "Realtek RTL9617C (Taurus)"
+	select ARM_GIC_V3
+	select COMMON_CLK
+	help
+	  Native peripheral support for the RTL9617C Cortex-A55 SoC.
 menu "Platform selection"
 
 config ARCH_ACTIONS
diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
index 1872f9d..e3bc34e 100644
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -1,4 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0-only
+config SPI_RTL9617C
+	tristate "Realtek RTL9617C QSPI"
+	depends on OF && ARCH_RTL9617C
+	select SPI_MEM
+	help
+	  Native single-lane PIO SPI-memory controller. NAND array writes
+	  are blocked by default, pending board ECC and recovery validation.
+
 #
 # SPI driver configuration
 #
diff --git a/drivers/spi/Makefile b/drivers/spi/Makefile
index 1f7c06a..5ea8f58 100644
--- a/drivers/spi/Makefile
+++ b/drivers/spi/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_SPI_RTL9617C) += spi-rtl9617c.o
 #
 # Makefile for kernel SPI drivers.
 #
diff --git a/drivers/tty/serial/Kconfig b/drivers/tty/serial/Kconfig
index 2b9c8b3..f349124 100644
--- a/drivers/tty/serial/Kconfig
+++ b/drivers/tty/serial/Kconfig
@@ -1,4 +1,18 @@
 # SPDX-License-Identifier: GPL-2.0
+config SERIAL_RTL9617C
+	tristate "Realtek RTL9617C UART"
+	depends on OF && ARCH_RTL9617C
+	select SERIAL_CORE
+	help
+	  Native driver for the Cortina FIFO UART on RTL9617C.
+
+config SERIAL_RTL9617C_CONSOLE
+	bool "Console on RTL9617C UART"
+	depends on SERIAL_RTL9617C=y
+	select SERIAL_CORE_CONSOLE
+	select SERIAL_EARLYCON
+	help
+	  Serial console and earlycon for TYFZA1 bring-up.
 #
 # Serial device configuration
 #
diff --git a/drivers/tty/serial/Makefile b/drivers/tty/serial/Makefile
index a2ccbc5..9f64be4 100644
--- a/drivers/tty/serial/Makefile
+++ b/drivers/tty/serial/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_SERIAL_RTL9617C) += rtl9617c-uart.o
 #
 # Makefile for the kernel serial device drivers.
 #
