--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -1,4 +1,12 @@
 # SPDX-License-Identifier: GPL-2.0-only
+
+config RTL9617C_XRAM_ETH
+	tristate "RTL9617C management XRAM Ethernet"
+	depends on OF && ARCH_RTL9617C && PHYLIB
+	select CRC32
+	help
+	  Single-port management Ethernet through the Taurus XRAM packet path.
+
 #
 # Realtek device configuration
 #
@@ -6,7 +14,7 @@
 config NET_VENDOR_REALTEK
 	bool "Realtek devices"
 	default y
-	depends on PCI || (PARPORT && X86)
+	depends on PCI || (PARPORT && X86) || ARCH_RTL9617C
 	help
 	  If you have a network (Ethernet) card belonging to this class, say Y.
 
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -1,4 +1,6 @@
 # SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_RTL9617C_XRAM_ETH) += rtl9617c-eth.o
+rtl9617c-eth-y := rtl9617c-xram.o rtl9617c-dma.o rtl9617c-qm.o
 #
 # Makefile for the Realtek network device drivers.
