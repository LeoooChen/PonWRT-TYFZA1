+			       const struct udphdr *head_udp)
+{
+	const struct iphdr *ip = (const struct iphdr *)udp - 1;
+	const struct iphdr *head_ip = (const struct iphdr *)head_udp - 1;
+	struct rtl9617c_udp_ipids *ipids;
+
+	if ((ip->ttl ^ head_ip->ttl) | (ip->tos ^ head_ip->tos) |
+	    ((ip->frag_off ^ head_ip->frag_off) & htons(IP_DF)))
+		return true;
+
+	ipids = skb_ext_find(head, SKB_EXT_RTL9617C_UDP_IPIDS);
+	if (!ipids) {
+		ipids = skb_ext_add(head, SKB_EXT_RTL9617C_UDP_IPIDS);
+		if (!ipids)
+			return true;
+		*ipids = (struct rtl9617c_udp_ipids){ .ids = { head_ip->id } };
+	}
+	ipids->ids[NAPI_GRO_CB(head)->count] = ip->id;
+	return false;
+}
+#endif
