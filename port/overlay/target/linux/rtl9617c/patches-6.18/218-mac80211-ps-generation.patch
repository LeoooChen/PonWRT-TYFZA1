+bool ieee80211_sta_eosp_generation(struct ieee80211_sta *pubsta, u32 generation)
+{
+	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
+	bool completed;
+
+	spin_lock_bh(&sta->ps_lock);
+	completed = sta->ps_generation == generation && test_sta_flag(sta, WLAN_STA_SP);
+	if (completed)
+		clear_sta_flag(sta, WLAN_STA_SP);
+	spin_unlock_bh(&sta->ps_lock);
+	return completed;
+}
+EXPORT_SYMBOL_GPL(ieee80211_sta_eosp_generation);
