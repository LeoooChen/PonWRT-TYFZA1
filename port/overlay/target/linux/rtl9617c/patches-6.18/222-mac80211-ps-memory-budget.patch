+/* Bound PS memory by the allocated skb size, not an obsolete 64-frame cap.
+ * Budgets include queued reservations; every removal releases before handing
+ * the skb to TX, where its truesize may change. Station and radio counters are
+ * atomic because different ACs/interfaces may enqueue and dequeue in parallel.
+ */
+#define IEEE80211_PS_STA_BYTES (8 * 1024 * 1024)
+#define IEEE80211_PS_RADIO_BYTES (16 * 1024 * 1024)
+
+static inline bool ieee80211_ps_reserve(atomic_t *used, unsigned int bytes,
+                                      unsigned int limit)
+{
+	int old = atomic_read(used);
+
+	if (bytes > limit)
+		return false;
+	for (;;) {
+		int found;
+
+		if ((unsigned int)old > limit - bytes)
+			return false;
+		found = atomic_cmpxchg(used, old, old + bytes);
+		if (found == old)
+			return true;
+		old = found;
+	}
+}
+
+static inline bool ieee80211_ps_charge(struct ieee80211_local *local,
+                                      struct sta_info *sta,
+                                      const struct sk_buff *skb)
+{
+	unsigned int bytes = skb->truesize;
+
+	if (!ieee80211_ps_reserve(&local->ps_buffered_bytes, bytes,
+				 IEEE80211_PS_RADIO_BYTES))
+		return false;
+	if (sta && !ieee80211_ps_reserve(&sta->ps_buffered_bytes, bytes,
+				       IEEE80211_PS_STA_BYTES)) {
+		atomic_sub(bytes, &local->ps_buffered_bytes);
+		return false;
+	}
+	return true;
+}
+
+static inline void ieee80211_ps_uncharge(struct ieee80211_local *local,
+                                        struct sta_info *sta,
+                                        const struct sk_buff *skb)
+{
+	atomic_sub(skb->truesize, &local->ps_buffered_bytes);
+	if (sta)
+		atomic_sub(skb->truesize, &sta->ps_buffered_bytes);
+}
+
+static inline void ieee80211_ps_uncharge_queue(struct ieee80211_local *local,
+                                              struct sta_info *sta,
+                                              struct sk_buff_head *queue)
+{
+	struct sk_buff *skb;
+
+	/* Caller holds the queue lock, or has excluded every queue user. */
+	skb_queue_walk(queue, skb)
+		ieee80211_ps_uncharge(local, sta, skb);
+}
+
 #endif /* IEEE80211_I_H */
