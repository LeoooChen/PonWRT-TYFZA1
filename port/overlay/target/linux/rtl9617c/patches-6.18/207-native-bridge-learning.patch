 EXPORT_SYMBOL_GPL(br_fdb_find_port);
+
+/* A hardware hit has the same ageing effect as a packet seen by the bridge. */
+void br_fdb_refresh_offload(const struct net_device *dev, const unsigned char *addr,
+                            u16 vid, bool source)
+{
+	const struct net_bridge_port *port;
+	struct net_bridge_fdb_entry *fdb;
+
+	ASSERT_RTNL();
+	rcu_read_lock();
+	port = br_port_get_rcu(dev);
+	if (port) {
+		fdb = br_fdb_find_rcu(port->br, addr, vid);
+		if (fdb && READ_ONCE(fdb->dst) == port) {
+			WRITE_ONCE(fdb->used, jiffies);
+			if (source)
+				WRITE_ONCE(fdb->updated, jiffies);
+		}
+	}
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(br_fdb_refresh_offload);
 
