+#ifdef CONFIG_ARCH_RTL9617C
+#define BR_LOCAL_UDP_BURST_NS (64 * NSEC_PER_USEC)
+#define BR_LOCAL_UDP_BATCH_NS (360 * NSEC_PER_USEC)
+
+static enum hrtimer_restart br_local_udp_timer(struct hrtimer *timer)
+{
+	struct net_bridge *br = container_of(timer, struct net_bridge, local_udp_timer);
+	unsigned int cpu = READ_ONCE(br->local_udp_cpu);
+
+	queue_work_on(cpu_online(cpu) ? cpu : WORK_CPU_UNBOUND, system_bh_wq,
+		      &br->local_udp_work);
+	return HRTIMER_NORESTART;
+}
+
+static void br_local_udp_drain(struct work_struct *work)
+{
+	struct net_bridge *br = container_of(work, struct net_bridge, local_udp_work);
+	struct sk_buff_head batch;
+	struct sk_buff *skb;
+
+	__skb_queue_head_init(&batch);
+	spin_lock(&br->local_udp_queue.lock);
+	skb_queue_splice_init(&br->local_udp_queue, &batch);
+	spin_unlock(&br->local_udp_queue.lock);
+
+	while ((skb = __skb_dequeue(&batch)))
+		br_dev_xmit_now(skb, br->dev);
+}
+
+static bool br_local_udp_enqueue(struct net_bridge *br, struct sk_buff *skb)
+{
+	const struct sock *sk = skb->sk;
+	struct sk_buff_head *queue = &br->local_udp_queue;
+	u64 now;
+	unsigned int cpu;
+	bool wake, burst;
+
+	if (!sk || !sk_fullsock(sk) || sk->sk_protocol != IPPROTO_UDP ||
+	    (skb->protocol != htons(ETH_P_IP) && skb->protocol != htons(ETH_P_IPV6)) ||
+	    skb_headlen(skb) < ETH_HLEN || is_multicast_ether_addr(skb->data) ||
+	    netpoll_tx_running(br->dev))
+		return false;
+
+	cpu = smp_processor_id() == 1 ? 3 : 1;
+	if (!cpu_online(cpu))
+		return false;
+
+	spin_lock(&queue->lock);
+	if (!netif_running(br->dev) || skb_queue_len(queue) >= 256) {
+		spin_unlock(&queue->lock);
+		dev_core_stats_tx_dropped_inc(br->dev);
+		kfree_skb_reason(skb, SKB_DROP_REASON_FULL_RING);
+		return true;
+	}
+	wake = skb_queue_empty(queue);
+	now = ktime_get_ns();
+	burst = now - br->local_udp_last_ns < BR_LOCAL_UDP_BURST_NS;
+	br->local_udp_last_ns = now;
+	__skb_queue_tail(queue, skb);
+	if (wake && burst) {
+		WRITE_ONCE(br->local_udp_cpu, cpu);
+		hrtimer_start(&br->local_udp_timer, ns_to_ktime(BR_LOCAL_UDP_BATCH_NS),
+			      HRTIMER_MODE_REL_PINNED_SOFT);
+	} else if (wake) {
+		queue_work_on(cpu, system_bh_wq, &br->local_udp_work);
+	}
+	spin_unlock(&queue->lock);
+	return true;
+}
+
+static void br_local_udp_stop(struct net_bridge *br)
+{
+	struct sk_buff_head pending;
+
+	__skb_queue_head_init(&pending);
+	spin_lock_bh(&br->local_udp_queue.lock);
+	skb_queue_splice_init(&br->local_udp_queue, &pending);
+	spin_unlock_bh(&br->local_udp_queue.lock);
+	hrtimer_cancel(&br->local_udp_timer);
+	cancel_work_sync(&br->local_udp_work);
+	__skb_queue_purge(&pending);
+}
+#endif
+
+netdev_tx_t br_dev_xmit(struct sk_buff *skb, struct net_device *dev)
+{
+#ifdef CONFIG_ARCH_RTL9617C
+	if (br_local_udp_enqueue(netdev_priv(dev), skb))
+		return NETDEV_TX_OK;
+#endif
+	return br_dev_xmit_now(skb, dev);
+}
