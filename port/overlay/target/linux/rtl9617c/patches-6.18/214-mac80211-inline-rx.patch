--- a/include/net/mac80211.h
+++ b/include/net/mac80211.h
@@ -2867,6 +2867,10 @@
  *	HW flag so drivers can opt in according to their own control, e.g. in
  *	testing.
  *
+ * @IEEE80211_HW_RX_INLINE: Deliver Ethernet frames before releasing RX path
+ *	serialization. Required when a hardware forwarding path shares RX sequence
+ *	state with mac80211; deferred delivery and RPS would reorder those paths.
+ *
  * @NUM_IEEE80211_HW_FLAGS: number of hardware flags, used for sizing arrays
  */
 enum ieee80211_hw_flags {
@@ -2927,6 +2931,7 @@
 	IEEE80211_HW_DISALLOW_PUNCTURING,
 	IEEE80211_HW_HANDLES_QUIET_CSA,
 	IEEE80211_HW_STRICT,
+	IEEE80211_HW_RX_INLINE,
 
 	/* keep last, obviously */
 	NUM_IEEE80211_HW_FLAGS
--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -2664,8 +2664,10 @@
 			     !ether_addr_equal(ehdr->h_dest, sdata->vif.addr)))
 			ether_addr_copy(ehdr->h_dest, sdata->vif.addr);
 
-		/* deliver to local stack */
-		if (rx->list)
+		/* Keep Ethernet submission inside the RX state handoff to hardware. */
+		if (ieee80211_hw_check(&rx->local->hw, RX_INLINE))
+			netif_receive_skb_core(skb);
+		else if (rx->list)
 			list_add_tail(&skb->list, rx->list);
 		else
 			netif_receive_skb(skb);
