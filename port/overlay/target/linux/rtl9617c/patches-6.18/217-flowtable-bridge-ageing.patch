+/* The caller holds RCU; an old hardware sample must not extend FDB lifetime. */
+void br_fdb_refresh_offload_rcu(const struct net_device *dev,
+				const unsigned char *addr, u16 vid,
+				unsigned long lastused)
+{
+	const struct net_bridge_port *port;
+	struct net_bridge_fdb_entry *fdb;
+
+	RCU_LOCKDEP_WARN(!rcu_read_lock_held(), "bridge FDB refresh without RCU");
+	port = br_port_get_rcu(dev);
+	if (!port)
+		return;
+	fdb = br_fdb_find_rcu(port->br, addr, vid);
+	if (fdb && READ_ONCE(fdb->dst) == port) {
+		if (time_after(lastused, READ_ONCE(fdb->used)))
+			WRITE_ONCE(fdb->used, lastused);
+		if (time_after(lastused, READ_ONCE(fdb->updated)))
+			WRITE_ONCE(fdb->updated, lastused);
+	}
+}
+EXPORT_SYMBOL_GPL(br_fdb_refresh_offload_rcu);
 
