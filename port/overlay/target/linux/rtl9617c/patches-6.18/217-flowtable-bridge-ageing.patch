+/* Traffic in this direction proves activity of the opposite path's peer.
+ * RTNL cannot be taken here: device cleanup flushes this workqueue under RTNL.
+ */
+void flow_offload_refresh_bridge(struct flow_offload *flow,
+				 enum flow_offload_tuple_dir dir,
+				 u64 lastused)
+{
+	const struct flow_offload_tuple *tuple = &flow->tuplehash[!dir].tuple;
+	struct net_device *bridge, *port;
+	struct net *net = nf_ct_net(flow->ct);
+
+	if (flow->type != NF_FLOW_OFFLOAD_ROUTE || !lastused ||
+	    tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT || !tuple->out.bridge_ifidx)
+		return;
+	rcu_read_lock();
+	bridge = dev_get_by_index_rcu(net, tuple->out.bridge_ifidx);
+	port = dev_get_by_index_rcu(net, tuple->out.bridge_port);
+	if (bridge && port &&
+	    br_fdb_find_port_rcu(bridge, tuple->out.h_dest, tuple->out.bridge_vid) == port)
+		br_fdb_refresh_offload_rcu(port, tuple->out.h_dest,
+					   tuple->out.bridge_vid, (unsigned long)lastused);
+	rcu_read_unlock();
+}
