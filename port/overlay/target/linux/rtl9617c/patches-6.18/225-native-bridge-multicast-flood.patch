+/* RTNL serializes these flag publications with native flow installation.
+ * Keep the RCU-pinned callback only around the non-sleeping assignment. */
+static inline void br_port_flags_set(struct net_bridge_port *p, unsigned long flags)
+{
+#ifdef CONFIG_ARCH_RTL9617C
+ const struct rtl9617c_bridge_mcast_ops *writer;
+ if (p->flags == flags)
+  return;
+ writer = rtl9617c_bridge_mcast_begin(p->br->dev);
+ WRITE_ONCE(p->flags, flags);
+ rtl9617c_bridge_mcast_end(writer);
+#else
+ p->flags = flags;
+#endif
+}
+
