--- a/drivers/net/ethernet/realtek/Kconfig
+++ b/drivers/net/ethernet/realtek/Kconfig
@@ -1,5 +1,17 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
+config RTL9617C_BOSA
+	tristate "RTL9617C optical front-end calibration"
+	depends on OF && ARCH_RTL9617C && I2C
+	select FW_LOADER
+
+config RTL9617C_PON
+	tristate "RTL9617C native PON MAC platform"
+	depends on OF && ARCH_RTL9617C && RTL9617C_XRAM_ETH && RTL9617C_BOSA
+	select FW_LOADER
+	help
+	  Native Taurus SerDes, optical front-end, EPON MAC and PON networking.
+
 config RTL9617C_XRAM_ETH
 	tristate "RTL9617C management XRAM Ethernet"
 	depends on OF && ARCH_RTL9617C && PHYLIB
--- a/drivers/net/ethernet/realtek/Makefile
+++ b/drivers/net/ethernet/realtek/Makefile
@@ -1,4 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0-only
+obj-$(CONFIG_RTL9617C_BOSA) += rtl9617c-bosa.o
+obj-$(CONFIG_RTL9617C_PON) += rtl9617c-pon-core.o
+rtl9617c-pon-core-y := rtl9617c-pon.o rtl9617c-pon-serdes.o rtl9617c-pon-epon.o rtl9617c-pon-mpcp.o rtl9617c-pon-pdc.o rtl9617c-pon-puc.o rtl9617c-pon-oam.o
 obj-$(CONFIG_RTL9617C_XRAM_ETH) += rtl9617c-eth.o
 rtl9617c-eth-y := rtl9617c-xram.o rtl9617c-dma.o rtl9617c-qm.o
 #
