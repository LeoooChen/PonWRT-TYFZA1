+static struct sk_buff *ip_make_udp_linear(struct sock *sk, struct flowi4 *fl4,
+					  struct msghdr *msg, int length,
+					  struct inet_cork *cork,
+					  unsigned int flags)
+{
+	const struct dst_entry *dst = cork->dst;
+	const struct net_device *dev = dst->dev;
+	netdev_features_t features = READ_ONCE(dev->features);
+	unsigned int headroom = LL_RESERVED_SPACE(dev);
+	unsigned int framelen = sizeof(struct iphdr) + length;
+	unsigned int alloclen = framelen + headroom + 15;
+	int headers = sizeof(struct iphdr) + sizeof(struct udphdr);
+	int payload = length - sizeof(struct udphdr);
+	struct sk_buff *skb;
+	char *data;
+	int err;
+
+	if (framelen > cork->fragsize ||
+	    (alloclen >= SKB_MAX_ALLOC && (features & NETIF_F_SG)))
+		return NULL;
+
+	skb = sock_alloc_send_skb(sk, alloclen, flags & MSG_DONTWAIT, &err);
+	if (!skb)
+		goto fail;
+
+	if (features & (NETIF_F_HW_CSUM | NETIF_F_IP_CSUM))
+		skb->ip_summed = CHECKSUM_PARTIAL;
+	skb->csum = 0;
+	skb_reserve(skb, headroom);
+	data = skb_put(skb, framelen);
+	skb_reset_network_header(skb);
+	skb_set_transport_header(skb, sizeof(struct iphdr));
+
+	if (payload && ip_generic_getfrag(msg, data + headers, 0, payload, 0, skb)) {
+		kfree_skb(skb);
+		err = -EFAULT;
+		goto fail;
+	}
+	if (flags & MSG_CONFIRM)
+		skb_set_dst_pending_confirm(skb, 1);
+
+	skb_shinfo(skb)->tx_flags = 0;
+	skb_shinfo(skb)->tskey = 0;
+	cork->length = length;
+	return ip_finish_datagram(sk, fl4, skb, cork);
+
+fail:
+	IP_INC_STATS(sock_net(sk), IPSTATS_MIB_OUTDISCARDS);
+	ip_cork_release(cork);
+	return ERR_PTR(err);
+}
