+#if defined(CONFIG_ARCH_RTL9617C) && defined(CONFIG_RFS_ACCEL)
+static s32 rtl9617c_wifi_rps_pending(unsigned int cpu)
+{
+	struct softnet_data *sd = &per_cpu(softnet_data, cpu);
+	u32 head = READ_ONCE(sd->input_queue_head);
+
+	return max_t(s32, READ_ONCE(sd->input_queue_tail) - head, 0);
+}
+
+/* NI misses for a VIF are handed off by the same serialized NAPI poll. */
+static int rtl9617c_wifi_rps_cpu(struct rps_dev_flow_table *table,
+				const struct rps_map *map, u32 hash,
+				struct rps_dev_flow **rflowp)
+{
+	struct rps_dev_flow *flow = &table->flows[rfs_slot(hash, table)];
+	unsigned int cpu = READ_ONCE(flow->cpu);
+	unsigned int index, other;
+
+	if (cpu < nr_cpu_ids && cpu_online(cpu) &&
+	    ((READ_ONCE(flow->hash) == hash &&
+	      (cpu == map->cpus[0] || cpu == map->cpus[1])) ||
+	     (s32)(READ_ONCE(per_cpu(softnet_data, cpu).input_queue_head) -
+		   READ_ONCE(flow->last_qtail)) < 0))
+		goto assigned;
+
+	/* Give new flows alternate CPUs unless one backlog is already busy. */
+	index = table->wifi_next_cpu++ & 1;
+	cpu = map->cpus[index];
+	other = map->cpus[index ^ 1];
+	if (!cpu_online(cpu) ||
+	    (cpu_online(other) && rtl9617c_wifi_rps_pending(cpu) >
+	     NAPI_POLL_WEIGHT + rtl9617c_wifi_rps_pending(other)))
+		cpu = other;
+	if (!cpu_online(cpu))
+		return -1;
+
+	WRITE_ONCE(flow->hash, hash);
+	rps_input_queue_tail_save(&flow->last_qtail,
+				  READ_ONCE(per_cpu(softnet_data, cpu).input_queue_head));
+	WRITE_ONCE(flow->cpu, cpu);
+assigned:
+	*rflowp = flow;
+	return cpu;
+}
