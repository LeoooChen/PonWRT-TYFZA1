--- a/net/mac80211/rx.c
+++ b/net/mac80211/rx.c
@@ -4317,7 +4317,7 @@
 	sta = container_of(pubsta, struct sta_info, sta);
 
 	local = sta->sdata->local;
-	WARN_ONCE(local->hw.max_rx_aggregation_subframes > 64,
+	WARN_ONCE(filtered && local->hw.max_rx_aggregation_subframes > 64,
