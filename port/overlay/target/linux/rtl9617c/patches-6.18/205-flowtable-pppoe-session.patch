+static bool nf_flow_tuple_uses_dev(const struct flow_offload_tuple *tuple,
+				   const struct net_device *dev)
+{
+	switch (tuple->xmit_type) {
+	case FLOW_OFFLOAD_XMIT_NEIGH:
+	case FLOW_OFFLOAD_XMIT_XFRM:
+		return tuple->dst_cache->dev == dev;
+	case FLOW_OFFLOAD_XMIT_DIRECT:
+		return tuple->out.ifidx == dev->ifindex ||
+		       tuple->out.hw_ifidx == dev->ifindex;
+	default:
+		return false;
+	}
+}
