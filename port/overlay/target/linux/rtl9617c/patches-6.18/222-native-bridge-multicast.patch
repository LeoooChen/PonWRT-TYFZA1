+static inline void br_multicast_write_begin(struct net_bridge *br)
+{
+#if defined(CONFIG_ARCH_RTL9617C) && defined(CONFIG_BRIDGE_IGMP_SNOOPING)
+ br->native_mcast_writer = rtl9617c_bridge_mcast_begin(br->dev);
+#endif
