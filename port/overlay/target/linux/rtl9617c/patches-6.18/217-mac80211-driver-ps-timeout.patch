+unsigned long ieee80211_sta_ps_buffer_timeout(struct ieee80211_sta *pubsta)
+{
+	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
+	unsigned long timeout;
+
+	/* Same two-listen-interval policy for skb and driver-owned queues. */
+	timeout = ((unsigned long)sta->listen_interval *
+		   sta->sdata->vif.bss_conf.beacon_int * 32 / 15625) * HZ;
+	return max_t(unsigned long, timeout, STA_TX_BUFFER_EXPIRE);
+}
+EXPORT_SYMBOL_GPL(ieee80211_sta_ps_buffer_timeout);
