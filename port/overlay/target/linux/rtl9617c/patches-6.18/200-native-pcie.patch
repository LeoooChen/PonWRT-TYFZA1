--- a/drivers/pci/controller/dwc/Kconfig
+++ b/drivers/pci/controller/dwc/Kconfig
@@ -2,6 +2,14 @@
 
 menu "DesignWare-based PCIe controllers"
 	depends on PCI
+
+config PCIE_RTL9617C
+	bool "Realtek RTL9617C PCIe host"
+	depends on OF && ARCH_RTL9617C && PCI_MSI
+	select PCIE_DW_HOST
+	select PHY_RTL9617C_PCIE
+	help
+	  Native Taurus DesignWare root complex with board SerDes and CCI DMA.
 
 config PCIE_DW
 	bool
--- a/drivers/pci/controller/dwc/Makefile
+++ b/drivers/pci/controller/dwc/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_PCIE_RTL9617C) += pcie-rtl9617c.o
 obj-$(CONFIG_PCIE_DW) += pcie-designware.o
 obj-$(CONFIG_PCIE_DW_DEBUGFS) += pcie-designware-debugfs.o
 obj-$(CONFIG_PCIE_DW_HOST) += pcie-designware-host.o
--- a/drivers/phy/Kconfig
+++ b/drivers/phy/Kconfig
@@ -1,4 +1,15 @@
 # SPDX-License-Identifier: GPL-2.0-only
+
+config PHY_RTL9617C_PCIE
+	bool "Realtek RTL9617C PCIe controls"
+	depends on OF && ARCH_RTL9617C
+	select GENERIC_PHY
+	select RESET_CONTROLLER
+	select COMMON_CLK
+	select MFD_SYSCON
+	help
+	  Native clock/reset/PHY providers for Taurus PCIe0 and PCIe1.
+
 #
 # PHY
 #
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
+obj-$(CONFIG_PHY_RTL9617C_PCIE) += phy-rtl9617c-pcie.o
 #
 # Makefile for the phy drivers.
 #
