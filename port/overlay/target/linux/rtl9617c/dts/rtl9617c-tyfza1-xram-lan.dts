#include "rtl9617c-tyfza1-stock-ubi-readonly.dts"

/ { model = "Tianyi TYFZA1 (management XRAM LAN bring-up)"; };

&mdio {
	status = "okay";
	phy0: ethernet-phy@1 {
		reg = <1>;
	};
	phy1: ethernet-phy@2 { reg = <2>; };
	phy2: ethernet-phy@3 { reg = <3>; };
	phy3: ethernet-phy@4 { reg = <4>; };
};

&{/soc} {
	ni0: ethernet@4f4300000 {
		compatible = "realtek,rtl9617c-xram-eth";
		reg = <4 0xf4300000 0 0x10000>, <0 0xf4500000 0 0x2000>;
		reg-names = "ni", "xram";
		realtek,port = <0>;
		phy-handle = <&phy0>;
	};
};
