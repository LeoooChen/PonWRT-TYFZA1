config RTL_AX_AP
	bool "TYFZA1 RTL8852C/RTL8192XB native AP backend"
	depends on PCI && ARCH_RTL9617C
	select FW_LOADER
	help
	  Native PCI endpoint identity, AP power, calibration and channel12 WCPU
	  firmware download for both TYFZA1 radios. The mac80211 data operations
	  are developed on top of this backend; no wireless interface exists yet.
