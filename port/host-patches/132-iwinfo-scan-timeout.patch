-	while (!cv.recv && !err)
+	/* A lost completion must not leave a deliberately paused AP down. */
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	deadline = now.tv_sec * 1000LL + now.tv_nsec / 1000000 + 10000;
+	while (!cv.recv && !err) {
