+/* This separate write-authorized RPC stops hostapd, never bypasses DFS. */
+static int
+rpc_scan_hostapd(int sock, const char *command)
+{
+	char reply[2048];
+	int len;
+
+	if (send(sock, command, strlen(command), 0) < 0)
+		return -1;
+	len = recv(sock, reply, sizeof(reply) - 1, 0);
+	if (len < 0) return -1;
+	reply[len] = 0;
+	if (!strcmp(command, "STATUS"))
+		return !strncmp(reply, "state=ENABLED\n", 14) ? 0 : -1;
+	return len >= 3 && !memcmp(reply, "OK\n", 3) ? 0 : -1;
+}
+
+static int
+rpc_scan_hostapd_open(char directory[32])
+{
+	struct sockaddr_un local = { .sun_family = AF_UNIX };
+	struct sockaddr_un remote = { .sun_family = AF_UNIX };
+	struct timeval timeout = { .tv_sec = 2 };
+	char phy[32], candidate[32];
+	struct dirent *entry;
+	DIR *interfaces;
+	int sock = -1;
+
+	if (strcmp(iw->name, "nl80211") || iw->phyname(ifname, phy))
+		return -1;
+	interfaces = opendir("/sys/class/net");
+	if (!interfaces)
+		return -1;
+	while ((entry = readdir(interfaces)) != NULL) {
+		if (entry->d_name[0] == '.' || strlen(entry->d_name) >= IFNAMSIZ ||
+		    iw->phyname(entry->d_name, candidate) || strcmp(phy, candidate))
+			continue;
+		snprintf(remote.sun_path, sizeof(remote.sun_path),
+			 "/var/run/hostapd/%.*s", IFNAMSIZ - 1, entry->d_name);
+		sock = socket(AF_UNIX, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+		if (sock < 0)
+			break;
+		if (!connect(sock, (struct sockaddr *)&remote, sizeof(remote)))
+			break;
+		close(sock);
+		sock = -1;
+	}
+	closedir(interfaces);
+	if (sock < 0)
+		return -1;
+	strcpy(directory, "/tmp/rpcd-scan-XXXXXX");
+	if (!mkdtemp(directory))
+		goto fail;
+	snprintf(local.sun_path, sizeof(local.sun_path), "%s/control", directory);
+	if (chmod(directory, 0711) ||
+	    bind(sock, (struct sockaddr *)&local, sizeof(local)) ||
+	    chmod(local.sun_path, 0660) || chown(local.sun_path, -1, 101) ||
+	    setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout)) ||
+	    setsockopt(sock, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout)))
+		goto fail;
+	return sock;
+fail:
+	close(sock);
+	unlink(local.sun_path);
+	rmdir(directory);
+	directory[0] = 0;
+	return -1;
+}
+
+static int
+rpc_scan_paused(char *results, int *length, bool *restore_failed)
+{
+	char directory[32] = {}, path[64];
+	int sock, ret = -1, cancel[2];
+	pid_t guard;
+
+	sock = rpc_scan_hostapd_open(directory);
+	if (sock < 0)
+		return -1;
+	/* Do not enable an AP which was already disabled or still in CAC. */
+	if (rpc_scan_hostapd(sock, "STATUS"))
+		goto out;
+	/* A socket pair also wakes recovery if rpcd exits; no inherited signal-handler race. */
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, cancel))
+		goto out;
+	guard = fork();
+	if (guard < 0) {
+		close(cancel[0]);
+		close(cancel[1]);
+		goto out;
+	}
+	if (!guard) {
+		struct pollfd fd = { .fd = cancel[0], .events = POLLIN };
+		char done;
+
+		close(cancel[1]);
+		if (poll(&fd, 1, 15000) > 0 && read(cancel[0], &done, 1) == 1)
+			_exit(0);
+		rpc_scan_hostapd(sock, "ENABLE");
+		if (getppid() == 1) {
+			snprintf(path, sizeof(path), "%s/control", directory);
+			unlink(path);
+			rmdir(directory);
+		}
+		_exit(0);
+	}
+	close(cancel[0]);
+	if (!rpc_scan_hostapd(sock, "DISABLE"))
+		ret = iw->scanlist(ifname, results, length);
+	/* Also restore after a lost DISABLE reply, not only a successful scan. */
+	*restore_failed = rpc_scan_hostapd(sock, "ENABLE") != 0;
+	if (!*restore_failed)
+		send(cancel[1], "x", 1, MSG_NOSIGNAL);
+	close(cancel[1]);
+	while (waitpid(guard, NULL, 0) < 0 && errno == EINTR) {}
+	if (*restore_failed)
+		*restore_failed = rpc_scan_hostapd(sock, "ENABLE") != 0;
+out:
+	close(sock);
+	snprintf(path, sizeof(path), "%s/control", directory);
+	unlink(path);
+	rmdir(directory);
+	return ret;
+}
