#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=11
STOP=88
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/tyfza1-recorder run
	# Bound retries on a full/read-only overlay rather than a flash-write loop.
	procd_set_param respawn 3600 30 3
	procd_set_param term_timeout 8
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

shutdown() {
	/usr/sbin/tyfza1-recorder shutdown-marker
	stop
}
